{
  "name": "papp-coordinator-api",
  "version": "0.11.0",
  "description": "RESTful API Coordinator for Participant App",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "test": "mocha --timeout 10000",
    "test:coverage": "c8 --reporter=text --reporter=lcov mocha --timeout 10000",
    "test:coverage:report": "c8 report --reporter=html --reporter=text-summary",
    "start:qa": "cross-env NODE_ENV=qa node index.js",
    "start:dev": "cross-env NODE_ENV=development node index.js",
    "start:production": "cross-env NODE_ENV=production node index.js",
    "lint": "eslint \"{app,configure,test}/**/*.js\" --max-warnings=0",
    "lint:fix": "pnpm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Subin Antony | santony@sentineladvantage.com",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "c8": "^10.1.3",
    "chai": "^6.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.31.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "mock-req-res": "^1.2.1",
    "prettier": "^3.6.2",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.13.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "express-bearer-token": "^3.0.0",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "hot-shots": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nconf": "^0.13.0",
    "rotating-file-stream": "^3.2.6",
    "twilio": "^6.1.2",
    "uuid": "^11.1.0",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
